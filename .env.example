# Sao chép file này thành .env rồi chỉnh sửa (Windows PowerShell: Copy-Item .env.example .env)
# Mọi biến đều TÙY CHỌN: ứng dụng chạy được ngay mà không cần API key trả phí.

# --- Backend ---
PORT=8787

# Email liên hệ gửi kèm User-Agent để vào "polite pool" của Crossref (nhanh và ổn định hơn).
# Chỉ dùng để Crossref liên hệ khi cần; không được ghi log hay lưu lại. Để trống nếu không muốn dùng.
CONTACT_EMAIL=

# Key OpenAlex MIỄN PHÍ (https://openalex.org/settings/api). Không có key vẫn tìm được nhưng
# hạn mức ngày rất nhỏ và dùng chung theo IP. Chỉ đặt ở backend, tuyệt đối không đưa vào frontend.
OPENALEX_API_KEY=

# Key Semantic Scholar (miễn phí, đăng ký tại https://www.semanticscholar.org/product/api#api-key-form).
# Không có key thì nguồn này KHÔNG được bật (khi khảo sát, request không key bị HTTP 429 liên tục).
SEMANTIC_SCHOLAR_API_KEY=

# Các origin được gọi API từ trình duyệt, phân tách bằng dấu phẩy (chỉ cần khi frontend deploy riêng).
# Ví dụ: https://paperfinder.pages.dev
CORS_ORIGIN=

# Timeout mỗi request tới API học thuật (ms), số lần thử lại tối đa, thời gian cache (giây).
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=2
CACHE_TTL_SECONDS=600

# Giới hạn số request tới backend của PaperFinder mỗi phút trên mỗi IP (chống lạm dụng khi deploy công khai).
RATE_LIMIT_PER_MINUTE=30

# Khi deploy sau reverse proxy (Render, Railway, Nginx...) đặt 1 để nhận đúng IP người dùng.
TRUST_PROXY=

# Thư mục frontend đã build để backend phục vụ luôn (mặc định tự dùng web/dist nếu có).
STATIC_DIR=

# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Frontend (chỉ cần khi frontend và backend deploy ở hai địa chỉ khác nhau) ---
# Đặt trong web/.env.production hoặc biến môi trường lúc build, ví dụ: https://api.example.com
# VITE_API_BASE_URL=
