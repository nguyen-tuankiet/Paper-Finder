# Sao chép file này thành .env rồi chỉnh sửa (Windows PowerShell: Copy-Item .env.example .env)
# Mọi biến đều TÙY CHỌN: ứng dụng chạy được ngay mà không cần API key trả phí.

# --- Backend ---
PORT=8787

# Email liên hệ gửi kèm User-Agent để vào "polite pool" của Crossref (nhanh và ổn định hơn).
# Chỉ dùng để Crossref liên hệ khi cần; không được ghi log hay lưu lại. Để trống nếu không muốn dùng.
CONTACT_EMAIL=

# Key OpenAlex MIỄN PHÍ (https://openalex.org/settings/api). Không có key vẫn tìm được nhưng
# hạn mức ngày rất nhỏ và dùng chung theo IP. Chỉ đặt ở backend, tuyệt đối không đưa vào frontend.
OPENALEX_API_KEY=

# Key Semantic Scholar (miễn phí, đăng ký tại https://www.semanticscholar.org/product/api#api-key-form).
# Không có key thì nguồn này KHÔNG được bật (khi khảo sát, request không key bị HTTP 429 liên tục).
SEMANTIC_SCHOLAR_API_KEY=

# Các origin được gọi API từ trình duyệt, phân tách bằng dấu phẩy (chỉ cần khi frontend deploy riêng).
# Ví dụ: https://paperfinder.pages.dev
CORS_ORIGIN=

# Timeout mỗi request tới API học thuật (ms), số lần thử lại tối đa, thời gian cache (giây).
REQUEST_TIMEOUT_MS=20000
MAX_RETRIES=2
CACHE_TTL_SECONDS=600

# Giới hạn số request tới backend của PaperFinder mỗi phút trên mỗi IP (chống lạm dụng khi deploy công khai).
RATE_LIMIT_PER_MINUTE=30

# Nút "Tải PDF": máy chủ chuyển tiếp file PDF miễn phí để trình duyệt tải về trực tiếp (chỉ link do chính máy chủ
# đã ký trong kết quả tìm kiếm, chặn địa chỉ nội bộ, chỉ nhận dữ liệu thật sự là PDF).
# Khóa ký link (tùy chọn, >= 16 ký tự). Bỏ trống = tạo ngẫu nhiên mỗi lần khởi động (link cũ hết hạn khi khởi động lại).
DOWNLOAD_SECRET=
# Dung lượng tối đa mỗi file chuyển tiếp (MB).
DOWNLOAD_MAX_MB=100

# Mật khẩu trang quản trị /admin (xem thống kê số người dùng, số lượt tìm). Tối thiểu 8 ký tự.
# Để trống = trang admin và API admin bị TẮT. Hãy dùng mật khẩu dài, khó đoán.
ADMIN_PASSWORD=

# File lưu thống kê sử dụng (ẩn danh: chỉ số đếm và mã băm một chiều, không lưu IP/từ khóa). Nếu đã đặt DATABASE_URL thì thống kê
# lưu trong PostgreSQL và file này không dùng. Mặc định ./data/stats.json trong thư mục backend. Múi giờ chia ngày và số ngày lưu:
STATS_FILE=
STATS_TIMEZONE=Asia/Ho_Chi_Minh
STATS_RETENTION_DAYS=365

# Khi deploy sau reverse proxy (Render, Railway, Nginx...) đặt 1 để nhận đúng IP người dùng.
TRUST_PROXY=

# Thư mục frontend đã build để backend phục vụ luôn (mặc định tự dùng web/dist nếu có).
STATIC_DIR=

# File CSV xếp hạng tạp chí tải từ scimagojr.com (bạn tự tải và đọc điều khoản của họ). Mặc định ./data/scimagojr.csv.
# Không có file thì tính năng xếp hạng Q1-Q4 tự tắt. Xem DEPLOY.md mục 7.5.
SJR_CSV_PATH=

# debug | info | warn | error | silent
LOG_LEVEL=info

# --- Frontend (chỉ cần khi frontend và backend deploy ở hai địa chỉ khác nhau) ---
# Đặt trong web/.env.production hoặc biến môi trường lúc build, ví dụ: https://api.example.com
# VITE_API_BASE_URL=

# --- Tài khoản, gói Pro, thanh toán (TẤT CẢ tùy chọn) ---
# Đặt SESSION_SECRET (>= 32 ký tự ngẫu nhiên) để BẬT tài khoản: đăng nhập, giới hạn theo hạng, gói trả phí.
# Để trống = tắt hoàn toàn, ai cũng tìm không giới hạn như trước.
# Tạo khóa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Chuỗi kết nối PostgreSQL (Neon, Supabase...) để lưu tài khoản bền vững. BẮT BUỘC khi chạy trên Render.
# Để trống = lưu file JSON ACCOUNTS_FILE (chỉ phù hợp chạy local hoặc máy chủ có ổ đĩa bền).
DATABASE_URL=
ACCOUNTS_FILE=

# Lượt tìm mỗi ngày (mỗi từ khóa tính một lượt): khách chưa đăng nhập và thành viên miễn phí.
# Hạng Tiêu chuẩn và Pro không giới hạn. Các giới hạn khác của từng hạng (số kết quả, xuất file, thư viện...)
# nằm trong server/src/accounts/plans.ts (hàm buildEntitlements).
FREE_DAILY_SEARCHES=10
GUEST_DAILY_SEARCHES=3

# Giá từng gói (VND, tối thiểu 2000): hạng Tiêu chuẩn và Pro, mỗi hạng 7 ngày / 1 tháng (30 ngày) / 1 năm (365 ngày).
PRICE_STANDARD_WEEK=10000
PRICE_STANDARD_MONTH=29000
PRICE_STANDARD_YEAR=119000
PRICE_PRO_WEEK=20000
PRICE_PRO_MONTH=49000
PRICE_PRO_YEAR=229000

# Thanh toán chuyển khoản QR qua SePay (https://sepay.vn). Cần đủ KEY + BANK_ACCOUNT + BANK_NAME mới bật nút thanh toán.
# SEPAY_API_KEY: chuỗi bí mật bạn tự đặt (>= 8 ký tự), điền y hệt vào cấu hình webhook của SePay (kiểu xác thực "API Key").
# SEPAY_BANK_ACCOUNT / SEPAY_BANK_NAME: tài khoản nhận tiền đã liên kết với SePay (BIDV: dùng số VA, có thể có chữ cái); tên ngân hàng theo danh sách của VietQR (vd. MBBank, Vietcombank, ACB).
# SEPAY_CODE_PREFIX: tiền tố mã thanh toán (2-6 chữ cái, mặc định PF), phải trùng cấu hình "Cấu trúc mã thanh toán" trên SePay.
# Thử ở máy local không cần chuyển tiền thật: đặt giá trị bất kỳ rồi chạy  npm run sepay:simulate -- <mã đơn> <số tiền>
SEPAY_API_KEY=
SEPAY_BANK_ACCOUNT=
# Chỉ khi SEPAY_BANK_ACCOUNT là số VA (BIDV...): điền số tài khoản chính, nhiều số cách nhau bằng dấu phẩy.
SEPAY_ACCOUNT_ALIASES=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=
SEPAY_CODE_PREFIX=PF
